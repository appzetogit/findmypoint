{
  "ignore": {
    "files": ["src/**", "**/*.tsx", "**/*.jsx"]
  },
  "categories": {
    "Accessibility": "off",
    "Performance": "off",
    "Bugs": "off",
    "Maintainability": "off",
    "Security": "off"
  },
  "rules": {
    "no-array-index-as-key": "off",
    "rendering-hydration-mismatch-time": "off",
    "label-has-associated-control": "off",
    "no-render-in-render": "off",
    "jsx-no-constructed-context-values": "off",
    "prefer-dynamic-import": "off",
    "no-unknown-property": "off",
    "no-derived-useState": "off",
    "control-has-associated-label": "off",
    "heading-has-content": "off",
    "no-prop-callback-in-effect": "off",
    "anchor-is-valid": "off",
    "no-prevent-default": "off",
    "no-transition-all": "off"
  }
}
